{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "PcBuilder",
    "Audience": "PcBuilder",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "App": {
    "PublicBaseUrl": "http://localhost:5173"
  },
  "Smtp": {
    "Port": 587,
    "UseStartTls": true,
    "FromName": "PC Builder"
  }
}
