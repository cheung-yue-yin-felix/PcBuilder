@PcBuilderBackend.Api_HostAddress = http://localhost:5155
@ContentType = application/json

### Shared placeholders (replace with real IDs from GET responses)
@manufacturerId = 392b5b1b-6f13-4116-b365-170bad4f765d
@socketId = f8833c2a-9997-433e-b174-b6bca1a8f84f
@chipsetId = 777d51c9-3812-420e-9386-584ea2bc944b
@cpuSeriesId = 00000000-0000-0000-0000-000000000004
@gpuSeriesId = 00000000-0000-0000-0000-000000000005
@gpuId = 00000000-0000-0000-0000-000000000006
@cpuId = 00000000-0000-0000-0000-000000000007
@graphicsCardId = 00000000-0000-0000-0000-000000000008
@memoryId = 00000000-0000-0000-0000-000000000009
@motherboardId = 00000000-0000-0000-0000-00000000000a


### Get Specification

GET {{PcBuilderBackend.Api_HostAddress}}/openapi/v1.json
Accept: application/json

###############################################################################
# Master Data - Manufacturer
# Routes: /api/master-data/manufacturer
###############################################################################

### Get All Manufacturers
GET {{PcBuilderBackend.Api_HostAddress}}/api/master-data/manufacturer
Accept: application/json

###

### Get Manufacturer by Id
GET {{PcBuilderBackend.Api_HostAddress}}/api/master-data/manufacturer/{{manufacturerId}}
Accept: application/json

###

### Create Manufacturer
POST {{PcBuilderBackend.Api_HostAddress}}/api/master-data/manufacturer
Content-Type: {{ContentType}}
Accept: application/json

{
  "name": "NVIDIA"
}

###

### Update Manufacturer
PUT {{PcBuilderBackend.Api_HostAddress}}/api/master-data/manufacturer
Content-Type: {{ContentType}}
Accept: application/json

{
  "id": "{{manufacturerId}}",
  "name": "NVIDIA"
}

###

### Delete Manufacturer
DELETE {{PcBuilderBackend.Api_HostAddress}}/api/master-data/manufacturer/{{manufacturerId}}
Accept: application/json

###

### Bulk Create Manufacturers
POST {{PcBuilderBackend.Api_HostAddress}}/api/master-data/manufacturer/bulk
Content-Type: {{ContentType}}
Accept: application/json

{
  "names": [
    "ASUS",
    "MSI",
    "Gigabyte"
  ]
}

###

### Bulk Update Manufacturers
PUT {{PcBuilderBackend.Api_HostAddress}}/api/master-data/manufacturer/bulk
Content-Type: {{ContentType}}
Accept: application/json

{
  "manufacturers": [
    {
      "id": "{{manufacturerId}}",
      "name": "ASUS"
    }
  ]
}

###

### Bulk Delete Manufacturers
# Body is a raw Guid array (not wrapped)
DELETE {{PcBuilderBackend.Api_HostAddress}}/api/master-data/manufacturer/bulk
Content-Type: {{ContentType}}
Accept: application/json

[
  "{{manufacturerId}}"
]

###

