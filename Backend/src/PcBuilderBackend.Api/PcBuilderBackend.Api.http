  "videoMemoryGb": 12,
  "pcieSlotsUsed": 2,
  "pcieGeneration": 4,
  "lengthMm": 305.0,
  "widthMm": 138.0,
  "heightMm": 65.0,
  "powerConsumptionWatts": 200,
  "powerConnectorType": 3,
  "powerConnectorCount": 1
}

